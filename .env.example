# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reby

# Secret used to sign/verify access-token JWTs (min 32 chars); distinct purpose from any refresh-token secret
JWT_ACCESS_SECRET=replace_with_a_random_32plus_character_secret

# How long issued access tokens stay valid, in minutes
ACCESS_TOKEN_TTL_MINUTES=15

# How long issued refresh tokens (in the httpOnly cookie) stay valid, in days
REFRESH_TOKEN_TTL_DAYS=30

# Redis connection string, used for caching and BullMQ queues
REDIS_URL=redis://localhost:6379

# Cloudinary connection string, used for image uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Firebase Cloud Messaging server key, used for push notifications
FCM_SERVER_KEY=fcm_placeholder

# Sentry DSN, used for error tracking
SENTRY_DSN=https://public@sentry.example.com/1

# Comma-separated list of allowed CORS origins (optional — permissive by default in development)
CORS_ORIGIN=
